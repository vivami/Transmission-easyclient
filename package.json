{
  "name": "trnasmission-easy-client",
  "version": "1.0.0",
  "scripts": {
    "watch": "cross-env BROWSER=chrome MODE=development webpack --mode development --watch --config webpack.config.js",
    "watchFirefox": "cross-env BROWSER=firefox MODE=development webpack --mode development --watch --config webpack.config.js",
    "build": "cross-env BROWSER=chrome MODE=production webpack --mode production --config webpack.config.js",
    "buildFirefox": "cross-env BROWSER=firefox MODE=production webpack --mode production --config webpack.config.js",
    "_compress": "node ./builder/compressDist",
    "_compressSource": "node ./builder/compressSource",
    "_releaseCh": "npm run build && cross-env BROWSER=chrome npm run _compress",
    "_releaseFf": "npm run buildFirefox && cross-env BROWSER=firefox npm run _compress && cross-env BROWSER=firefox npm run _compressSource",
    "release": "npm run _releaseCh && npm run _releaseFf"
  },
  "dependencies": {
    "d3-ease": "^3.0.1",
    "d3-scale": "^4.0.2",
    "d3-selection": "^3.0.0",
    "d3-shape": "^3.2.0",
    "d3-transition": "^3.0.1",
    "escape-string-regexp": "^2.0.0",
    "fecha": "^3.0.3",
    "filesize": "^6.0.1",
    "mobx": "^6.12.0",
    "mobx-react": "^9.1.0",
    "mobx-state-tree": "^6.0.1",
    "promise-limit": "^2.7.0",
    "prop-types": "^15.7.2",
    "rc-select": "^9.2.2",
    "react": "^18.3.1",
    "react-color": "^2.17.3",
    "react-contexify": "^4.1.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^5.1.2",
    "react-tiny-popover": "^4.0.0",
    "serialize-error": "^13.0.1"
  },
  "devDependencies": {
    "@babel/cli": "^7.24.0",
    "@babel/core": "^7.24.0",
    "@babel/plugin-proposal-class-properties": "^7.18.6",
    "@babel/plugin-proposal-decorators": "^7.24.0",
    "@babel/plugin-syntax-dynamic-import": "^7.8.3",
    "@babel/preset-env": "^7.24.0",
    "@babel/preset-react": "^7.24.0",
    "@babel/register": "^7.24.0",
    "archiver": "^7.0.1",
    "babel-loader": "^9.1.3",
    "copy-webpack-plugin": "^14.0.0",
    "cross-env": "^7.0.3",
    "css-loader": "^6.10.0",
    "css-minimizer-webpack-plugin": "^8.0.0",
    "html-webpack-plugin": "^5.6.0",
    "less": "^4.2.0",
    "less-loader": "^11.1.4",
    "mini-css-extract-plugin": "^2.8.1",
    "webpack": "^5.91.0",
    "webpack-cli": "^5.1.4"
  }
}
